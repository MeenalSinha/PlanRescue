{
  "name": "planrescue",
  "version": "0.1.0",
  "private": true,
  "description": "PlanRescue: consequence-aware schedule recovery. Phase 0 and 1: MCP server foundation (Streamable HTTP).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:mcp": "tsx watch apps/mcp-server/src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start:mcp": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/time.test.ts tests/seed-data.test.ts tests/config.test.ts tests/server-meta.test.ts",
    "test:mcp": "npm run build && vitest run tests/mcp-smoke.test.ts",
    "demo:client": "tsx scripts/demo-client.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
