{
  "name": "planrescue-web",
  "version": "0.1.0",
  "private": true,
  "description": "PlanRescue web interface (Phases 4-9). Talks to the PlanRescue MCP server through server-side route handlers only.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.e2e.test.*'",
    "test:bedrock": "vitest run tests/agent.bedrock.test.ts",
    "test:bedrock:live": "tsx scripts/test-bedrock-live.ts",
    "test:integration": "vitest run 'tests/**/*.integration.test.ts'",
    "test:e2e": "vitest run 'tests/**/*.e2e.test.*'"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "13.0.3",
    "next": "^16.4.6",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
