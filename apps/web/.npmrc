# Do not run dependency install scripts.
#
# better-sqlite3 13 ships prebuilt binaries inside its npm tarball and marks itself `gypfile: false`,
# but `npm ci` (which installs from the lockfile) does not see that flag and falls back to an implicit
# `node-gyp rebuild`. That needs a C++ toolchain and a download from nodejs.org, and fails without them
# (verified here). Every dependency with an install script (esbuild, fsevents) works without it, and
# skipping install scripts is also a sensible supply-chain default.
# If a future dependency genuinely needs a build step, remove this and run `npm rebuild <package>`.
ignore-scripts=true
engine-strict=false
