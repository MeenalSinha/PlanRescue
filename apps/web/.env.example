# PlanRescue web interface configuration. Server-side only: none of these values is sent to the browser.
# Copy to .env.local for local overrides. Every value is optional; the defaults shown are used when unset.

# Full URL of the running PlanRescue MCP server (Streamable HTTP endpoint).
# Must be http(s) and, unless PLANRESCUE_ALLOW_REMOTE_MCP=true, must point at a loopback host.
PLANRESCUE_MCP_URL=http://127.0.0.1:3001/mcp

# Milliseconds to wait for the MCP server before reporting it as unavailable (1000-60000).
PLANRESCUE_MCP_TIMEOUT_MS=10000

# IANA time zone of the calendar the MCP server holds (the sample data is Asia/Kolkata).
# Used only to turn a chosen calendar date into a day window with the right UTC offset.
PLANRESCUE_CALENDAR_TIME_ZONE=Asia/Kolkata

# Set to true only when the MCP server is deliberately not on this machine.
PLANRESCUE_ALLOW_REMOTE_MCP=false

# -----------------------------------------------------------------------------
# Phase 5: AI Agent Configuration (Server-side only)
# -----------------------------------------------------------------------------
# To enable natural-language schedule recovery, provide an OpenAI API key.
# When unset, the application remains fully functional using the structured form controls.
OPENAI_API_KEY=

# Optional. Set to false to disable the AI agent even if an API key is present.
PLANRESCUE_AGENT_ENABLED=true

# Optional. Model name to use for structured intent extraction (default: gpt-4o-mini).
PLANRESCUE_AGENT_MODEL=gpt-4o-mini

# Optional. Timeout in milliseconds for model inference (5000-120000, default: 30000).
PLANRESCUE_AGENT_TIMEOUT_MS=30000

# Optional. Custom base URL for compatible endpoints or local proxies.
# OPENAI_BASE_URL=

