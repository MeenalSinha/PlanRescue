# PlanRescue MCP server configuration.
# Copy to .env for local overrides. Every value below is optional; the defaults shown are used when unset.
# No secrets are required in this phase (no LLM, no database, no cloud credentials).

# Interface to bind. Keep 127.0.0.1 for local development.
MCP_HOST=127.0.0.1

# TCP port for the Streamable HTTP endpoint.
MCP_PORT=3001

# URL path of the MCP endpoint.
MCP_PATH=/mcp

# Runtime environment label: development | test | production
APP_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Optional. Comma-separated Host header names accepted by the DNS-rebinding guard.
# Needed only when MCP_HOST is not a loopback address (for example a later public deployment).
# Example: MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_HOSTS=
