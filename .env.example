# PlanRescue MCP server configuration.
# Copy to .env for local overrides. Every value below is optional; the defaults shown are used when unset.
# No secrets are required in this phase (no LLM, no cloud credentials). Data lives in a local SQLite file.

# Interface to bind. Keep 127.0.0.1 for local development.
MCP_HOST=127.0.0.1

# TCP port for the Streamable HTTP endpoint.
MCP_PORT=3001

# URL path of the MCP endpoint.
MCP_PATH=/mcp

# Runtime environment label: development | test | production
APP_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Optional. Comma-separated Host header names accepted by the DNS-rebinding guard.
# Needed only when MCP_HOST is not a loopback address (for example a later public deployment).
# Example: MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_HOSTS=

# Path of the SQLite database file. Created, with its directory, on first start and seeded with sample data.
# Relative paths resolve against the working directory (the repository root when using the npm scripts),
# the same place this .env file is read from. ":memory:" is rejected because data must persist.
DATABASE_PATH=./data/planrescue.sqlite

# Note: For Natural-Language AI Agent settings (OpenAI or Amazon Bedrock runtime configuration),
# see apps/web/.env.example.

